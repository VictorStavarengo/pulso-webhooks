# Pulso — modelo de configuração. Copie para .env e preencha o que for usar.
# Linhas comentadas permanecem no padrão.

# ---------------------------------------------------------------- Banco
# Padrão: SQLite em ecommerce.db (zero configuração).
# DATABASE_URL=postgresql+psycopg://usuario:senha@127.0.0.1:5432/pulso

# ---------------------------------------------------------------- Redis
# Opcional: SSE entre múltiplos workers + rate limit compartilhado.
# REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- Sessão
# Gerado automaticamente em .pulso-sessao se ausente.
# SESSION_SECRET=troque-por-um-valor-aleatorio
# Em container, aponte para o volume para sobreviver a recriações.
# PULSO_SESSAO_ARQUIVO=/dados/.pulso-sessao

# ---------------------------------------------------------------- Acesso inicial
# Usados apenas na criação do banco; troque antes de expor o painel.
# PULSO_ADMIN_EMAIL=admin@pulso.local
# PULSO_ADMIN_SENHA=pulso123
# PULSO_LOJA_PADRAO=Minha Loja

# ---------------------------------------------------------------- E-mail (SMTP)
PULSO_SMTP_HOST=
PULSO_SMTP_PORTA=587
PULSO_SMTP_USUARIO=
PULSO_SMTP_SENHA=
# starttls | ssl | nenhuma
PULSO_SMTP_SEGURANCA=starttls
PULSO_ALERTA_REMETENTE=

# ---------------------------------------------------------------- Telegram
PULSO_TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- WhatsApp (Cloud API)
PULSO_WHATSAPP_TOKEN=
PULSO_WHATSAPP_PHONE_ID=
PULSO_WHATSAPP_TEMPLATE=pulso_alerta
PULSO_WHATSAPP_IDIOMA=pt_BR

# ---------------------------------------------------------------- Operação
PULSO_RETENCAO_DIAS=90
PULSO_RATE_LIMIT_LOGIN=10
PULSO_RATE_LIMIT_WEBHOOK=300
# PULSO_WEBHOOK_TOLERANCIA=300
# PULSO_ALERTAS_EXTERNAS=1
# Tentativas totais por envio; depois do limite o alerta vira dead-letter.
# PULSO_ALERTA_MAX_TENTATIVAS=4
# Atrasos em segundos entre retentativas (o último se repete).
# PULSO_ALERTA_BACKOFF=60,300,900
# Intervalo do worker que varre a fila de entrega, em segundos.
# PULSO_ALERTA_RETENTATIVA_INTERVALO=30
# Semeia pedidos, notificações e fila de entrega fictícios em banco vazio (demo pública).
# PULSO_DEMO_SEED=1

# ---------------------------------------------------------------- Produção
# PULSO_COOKIE_SECURE=1
# PULSO_TRUST_PROXY=1
# PULSO_SERVIR_FRONTEND=1
# ALLOWED_ORIGINS=https://painel.sualoja.com.br
# SENTRY_DSN=
# PULSO_LOG_JSON=1
